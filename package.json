{
  "name": "horyzont",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Horyzont — reguła 20-20-20 jako PWA z web push",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:native": "esbuild src/native.js --bundle --format=esm --outfile=public/native.js --target=es2020 --minify",
    "android:sync": "npm run build:native && npx cap sync android"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "express": "^4.21.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "esbuild": "^0.28.2"
  }
}
